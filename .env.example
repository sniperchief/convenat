# Covenant — environment template.
# Copy to `.env` and fill in. NEVER commit a populated .env.
#
# Variables are grouped by the milestone that first needs them. Milestones 1 and 2
# (packages/shared, packages/contracts) require NONE of these — both are pure,
# offline, and have no runtime configuration.

# ---------------------------------------------------------------------------
# M2/M4 — contracts (local + testnet deployment)
# ---------------------------------------------------------------------------
#
# TESTNET KEYS ONLY. Every key below controls an account holding worthless test
# OKB and worthless TestUSD. Never put a key here that holds anything real —
# this file's populated sibling is gitignored, but a key in a .env is a key on a
# laptop, and that is not custody.
#
# The four accounts have distinct roles and must be distinct accounts:
#   DEPLOYER  deploys the contracts and holds DEFAULT_ADMIN_ROLE on the factory
#   RESOLVER  holds PROPOSER_ROLE only — it can never move funds
#   WALLET_A  an ordinary participant; creates the test market and stakes YES
#   WALLET_B  a second, independent participant; stakes NO and challenges
#
# Hardhat reads these in this order as the xlayerTestnet account list.

DEPLOYER_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
WALLET_A_PRIVATE_KEY=
WALLET_B_PRIVATE_KEY=

# Addresses of the four accounts above. Convenience only — derivable from the
# keys, and used by tooling that must not touch a key to learn an address.
DEPLOYER_ADDRESS=
RESOLVER_ADDRESS=
WALLET_A_ADDRESS=
WALLET_B_ADDRESS=

# ---------------------------------------------------------------------------
# M3 — backend
# ---------------------------------------------------------------------------

NODE_ENV=development

# Fastify bind configuration.
API_HOST=127.0.0.1
API_PORT=8080

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Whether raw user prompts may be written to logs. Off by default: a condition
# can name a counterparty, a contract value, or a shipment. Turning this on is a
# deliberate decision, not a debugging convenience.
LOG_USER_CONTENT=false

# Postgres / Supabase connection string.
DATABASE_URL=

# LLM provider key for the condition compiler.
ANTHROPIC_API_KEY=
# Model id used for compilation. Defaults to claude-haiku-4-5 ($1/$5 per 1M
# tokens) — the cheapest current model, and enough for this task because the
# system, not the model, enforces correctness: strict schema parsing, shared
# validation, and operator-supplied economics.
LLM_MODEL=claude-haiku-4-5
# Output budget. On Opus-tier models thinking is ON BY DEFAULT and is billed
# against this same budget, so raising the model without raising this truncates
# the JSON mid-object. Haiku 4.5 does no thinking, so 16000 is ample.
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_MS=120000

# The chain this backend serves. Must match the settlement token's chain.
CHAIN_ID=1952

# Settlement token, from the deployment manifest for CHAIN_ID.
# Supplied by the operator rather than compiled in: no token address appears
# anywhere in source (ADR-0005). Until M4 deploys, this is the local TestUSD.
SETTLEMENT_TOKEN_ADDRESS=
SETTLEMENT_TOKEN_SYMBOL=TUSD
SETTLEMENT_TOKEN_DECIMALS=6

# Market terms the backend applies to every compiled condition.
# These are operator policy, deliberately NOT chosen by the model — they end up
# inside the rules hash a user is asked to approve.
#   how long before the deadline that staking closes
MARKET_TRADING_LEAD_SECONDS=86400
#   how long a resolution stays contestable
MARKET_CHALLENGE_WINDOW_SECONDS=7200
#   challenge bond, in settlement-token base units
MARKET_CHALLENGE_BOND_BASE_UNITS=50000000
#   how long the resolver has before anyone may cancel into refunds
MARKET_RESOLUTION_WINDOW_SECONDS=604800

# ---------------------------------------------------------------------------
# M4 — X Layer deployment, indexing, verification
# ---------------------------------------------------------------------------

# Which network this process targets: local | xlayer-testnet
# Must agree with CHAIN_ID; startup fails if they disagree. `xlayer-mainnet` is
# rejected by this build — mainnet is out of scope until an external audit.
NETWORK=xlayer-testnet

# RPC override. The default comes from packages/shared/src/chains/xlayer.ts,
# verified live in M4: https://testrpc.xlayer.tech/terigon serves chain 1952.
# Set this for a private or authenticated endpoint. Treated as a credential —
# an RPC URL can carry an API key in its path, so it is never logged.
XLAYER_RPC_URL=
XLAYER_TESTNET_RPC_URL=

# Path to the deployment manifest. Contract addresses come from here and from
# nowhere else; no address is compiled into any source file. Startup fails if
# the manifest is missing, malformed, or for a different chain or environment.
X_LAYER_DEPLOYMENT_MANIFEST=

# Block explorer API key used for contract verification.
XLAYER_EXPLORER_API_KEY=

# Blocks the indexer stays behind head before treating a block as final.
# May be raised above the network minimum (5 for X Layer testnet) but never
# lowered below it — that would mean indexing blocks that can still be replaced.
INDEXER_CONFIRMATIONS=5
# Largest block span per eth_getLogs call. 100 is X Layer testnet's measured
# cap — a wider request is rejected with "block range greater than 100 max".
INDEXER_LOG_RANGE=100
# How far back the indexer re-checks block hashes to detect a reorg.
INDEXER_REORG_WINDOW=32
INDEXER_POLL_INTERVAL_MS=12000

# --- wallet authentication (SIWE / EIP-4361) --------------------------------
# The domain is bound into the message the wallet signs and must be the origin
# actually serving the frontend; a mismatch is what makes a signature captured
# on one site useless on another.
AUTH_DOMAIN=localhost:8080
AUTH_URI=http://localhost:8080
AUTH_NONCE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=86400

# --- integration tests ------------------------------------------------------
# A PostgreSQL the integration suite may create and drop tables in. Point it at
# a scratch database, never at the one holding anything you want to keep.
TEST_DATABASE_URL=


# ---------------------------------------------------------------------------
# M5.5–M5.7 — resolution, on-chain submission, frontend
# ---------------------------------------------------------------------------

# Confidence floor for PROPOSING at all, in integer basis points. 7000 = 70%.
#
# This is not a settlement rule. There is no confidence parameter in Solidity
# and no path from this number to a payout — below the floor the resolver
# returns NEEDS_REVIEW and proposes nothing. Lowering it does NOT make the
# system settle on weaker evidence: the deterministic verdict must still be
# conclusive and the model must still concur with it.
#
# Basis points rather than a percentage float, so this can never be compared
# against a fraction somewhere else and quietly mean a hundredth of what was
# intended.
RESOLUTION_CONFIDENCE_FLOOR_BPS=7000

# Per-source ceiling on the evidence text rendered into the resolver prompt.
# Truncation is always declared to the model, so it cannot read an absence
# caused by our own bound as an absence in the source.
RESOLUTION_MAX_EVIDENCE_CHARS=6000

# How long to wait for a proposal transaction before abandoning the wait.
# Abandoning is not failing: the record keeps the hash and stays SUBMITTED,
# because a transaction that lands a second later must not be reported failed.
CHAIN_CONFIRMATION_TIMEOUT_MS=180000

# Browser origins permitted to call this API, comma-separated.
#
# Explicit, never "*". The API carries bearer tokens, and a wildcard would let
# any page a user visits spend their session. Must match the origin the web
# process is actually served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- web (apps/web) ---------------------------------------------------------
# The static server reads these directly; nothing is bundled and no secret is
# ever served to the browser.
WEB_PORT=5173
WEB_HOST=127.0.0.1
WEB_API_BASE=http://127.0.0.1:8080
