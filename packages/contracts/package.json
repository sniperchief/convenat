{
  "name": "@covenant/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "MarketFactory, ConditionalMarket and TestUSD. The financial and lifecycle layer.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "hardhat compile",
    "typecheck": "tsc --noEmit",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:local": "hardhat run scripts/deploy-local.ts",
    "abi:export": "hardhat run scripts/export-abi.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network xlayerTestnet",
    "fund:testnet": "hardhat run scripts/fund-wallets.ts --network xlayerTestnet",
    "market:testnet": "hardhat run scripts/create-market.ts --network xlayerTestnet",
    "lifecycle:testnet": "hardhat run scripts/lifecycle.ts --network xlayerTestnet",
    "verify:testnet": "hardhat run scripts/verify.ts --network xlayerTestnet",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0"
  },
  "devDependencies": {
    "@covenant/shared": "0.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.12",
    "dotenv": "^16.4.7",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.9.0",
    "chai": "^4.5.0",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
