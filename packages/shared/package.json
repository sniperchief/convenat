{
  "name": "@covenant/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical condition specification, deterministic canonicalization and protocol hashing. The single source of truth for rulesHash and evidenceHash.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/fixtures.d.ts",
      "default": "./dist/testing/fixtures.js"
    },
    "./vectors/golden.json": "./vectors/golden.json"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors:generate": "npm run build && node scripts/generate-golden-vectors.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "viem": "^2.21.54",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
